# Скопируй в .env и заполни своими значениями: cp .env.example .env
# .env НЕ коммитить (см. .gitignore).

# --- OpenRouter (все LLM-вызовы, §2.2) ---
OPENROUTER_API_KEY=

# --- LangSmith (наблюдаемость, §8.0) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=delivery-claims-ai
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # раскомментировать для EU-региона

# --- Модели по узлам (дефолтный бюджетный набор, §2.2) ---
MODEL_CLASSIFY=google/gemini-2.5-flash-lite
MODEL_EXTRACT=google/gemini-2.5-flash-lite
MODEL_JUDGE=deepseek/deepseek-chat
MODEL_EVAL=openai/gpt-4o-mini

# --- Прочее (§2.3) ---
# Фиксированная "дата прогона" для воспроизводимости in_transit-веток.
# Пусто = системная дата. Формат YYYY-MM-DD.
RUN_DATE=
